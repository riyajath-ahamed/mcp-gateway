{
  "name": "@configkits/mcp-gateway-client",
  "version": "0.1.0",
  "description": "TypeScript client SDK for mcp-gateway — one client, all your MCP servers",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["mcp", "model-context-protocol", "gateway", "ai", "agents", "proxy"],
  "author": "ConfigKits",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/configkits/mcp-gateway"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
